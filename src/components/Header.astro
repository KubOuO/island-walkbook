---
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { label: '首頁', href: base, path: '/' },
  { label: '找一條路線', href: `${base}walks/`, path: '/walks/' },
  { label: '一起新增', href: `${base}about/`, path: '/about/' },
];
const isActive = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="site-header">
  <a class="brand" href={base} aria-label="島嶼散步冊首頁">
    <span class="brand-mark" aria-hidden="true">走</span>
    <span>島嶼散步冊</span>
  </a>
  <nav class="site-nav" aria-label="主要導覽">
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.path) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
